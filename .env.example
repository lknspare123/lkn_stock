SECRET_KEY=change-me-to-a-long-random-string
APP_PASSWORD=choose-a-strong-password
# Neon dashboard -> your project -> Connect -> copy the connection string (use the "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# From Cloudinary dashboard -> API Keys
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Only for the one-time Firestore -> Neon copy: put serviceAccountKey.json in the project folder
